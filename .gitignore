# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
*/build/

# Local configuration file (yields SDK path and sensitive API keys)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio IDE files
*.iml
.idea/
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Keystore & Signing files (NEVER commit secrets or release keys to Git)
*.jks
*.keystore
key
key.txt

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services & Firebase (credentials / private config)
google-services.json
firebase.json
.firebaserc

# Mac & Windows OS temporary files
.DS_Store
Thumbs.db
desktop.ini

# Archives & Temporary zip packages
*.zip
*.tar
*.gz
*.7z
